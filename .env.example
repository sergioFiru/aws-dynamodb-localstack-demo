# Folosește acest fișier DOAR pentru imaginea nouă LocalStack (care cere token).
# 1. Copiază-l:  cp .env.example .env   (.env este în .gitignore și NU se comite)
# 2. Pune token-ul din contul gratuit (Hobby): https://app.localstack.cloud -> Auth Tokens
LOCALSTACK_IMAGE=localstack/localstack:latest
LOCALSTACK_AUTH_TOKEN=pune-aici-tokenul-tau
